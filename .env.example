# База данных PostgreSQL. Для docker compose эта строка подставляется автоматически.
DATABASE_URL=postgres://roadmaps:roadmaps@localhost:5432/roadmaps

# Секрет для подписи сессий. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (см. README → «Вход через Google»)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Адрес сайта в продакшене, например https://learn.example.com (локально можно не задавать)
# AUTH_URL=

# Вход по email без пароля — ТОЛЬКО для локальной разработки. На сервере не включать!
DEV_LOGIN=false

# Сколько секунд держать контент в памяти в продакшене (после git pull обновится через это время)
# CONTENT_CACHE_TTL=60
