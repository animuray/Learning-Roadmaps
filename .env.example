# База данных PostgreSQL. Для docker compose эта строка подставляется автоматически.
DATABASE_URL=postgres://roadmaps:roadmaps@localhost:5432/roadmaps

# Секрет для подписи сессий. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (см. README → «Вход через Google»)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Адрес сайта в продакшене, например https://learn.example.com (локально можно не задавать)
# AUTH_URL=

# Вход по email без пароля — ТОЛЬКО для локальной разработки. На сервере не включать!
DEV_LOGIN=false

# Сколько секунд держать контент в памяти в продакшене (после git pull обновится через это время)
# CONTENT_CACHE_TTL=60

# Песочница SQL-тренажёра: отдельная роль и база для запросов учеников.
# Локально создаётся командой `npm run sql:setup` (она же пропишет строку в .env),
# в docker-compose задаётся автоматически.
# SQL_PRACTICE_URL=postgres://sql_practice:sql_practice@localhost:5432/sql_practice

# Лаборатория: терминал на учебном стенде прямо на странице темы (docs/practice-lab.md).
# Без LAB_SECRET и LAB_SSH_HOST раздел «Лаборатория» показывается, но терминал не работает.
# LAB_SECRET=                      # общий секрет сайта и lab-runner: openssl rand -base64 32
# LAB_SSH_HOST=127.0.0.1           # стенд (sshd), куда заходят ключом .lab/id_ed25519 (npm run lab:key)
# LAB_SSH_PORT=2222
# LAB_SSH_KEY=.lab/id_ed25519
# LAB_WS_URL=ws://localhost:3001/lab/ws   # адрес lab-runner для браузера; на сервере — wss://ваш-домен/lab/ws
# LAB_RUNNER_PORT=3001
# LAB_WSL_DISTRO=lr-stand          # только для разработки: lab-runner держит WSL-стенд включённым
# LAB_ALLOWED_USERS=mylogin        # кому доступен терминал: логины через запятую, «*» — все вошедшие
# LAB_ALLOWED_EMAILS=you@gmail.com # то же по почте (вход через Google). При DEV_LOGIN=true — всем
