{
  "name": "learning-roadmaps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "sql:setup": "node --env-file-if-exists=.env scripts/setup-sql-practice.mjs",
    "sql:check": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/check-sql-tasks.mts",
    "lab:key": "node scripts/lab-key.mjs",
    "lab:stand:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lab-stand/wsl.ps1",
    "lab:runner": "node --env-file-if-exists=.env --import tsx lab-runner/server.ts",
    "lab:check": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/check-labs.mts",
    "db:studio": "drizzle-kit studio",
    "content:check": "tsx scripts/check-content.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.82.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "ssh2": "^1.17.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "ws": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
